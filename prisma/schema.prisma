generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Sarpanch {
  id          Int      @id @default(autoincrement())
  slug        String   @unique
  name        String
  image       String   @db.Text
  phone       String?
  description String?
  village     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
